# Generated from the {{ stack }} stack; `copier update` replaces this file.
# Override a task by defining it in mise.toml.
{{ extra_settings | default("") }}[tools]
"aqua:ddev/ddev" = "latest"
{{ extra_tools | default("") }}
[tasks.setup]
run = ["ddev start", "ddev composer install"]

[tasks.dev]
run = "ddev start"
