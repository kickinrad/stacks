{
  "type": "project",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "*",
    "friendsofphp/php-cs-fixer": "*",
    "pestphp/pest": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  }
}
