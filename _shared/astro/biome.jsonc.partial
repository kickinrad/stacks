{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  // Installed agent skills (.agents/skills) are their authors' files, not the project's.
  "files": { "includes": ["!public", "!.copier-answers.yml", "!.agents/skills"] },
  "overrides": [
    {
      // Astro components are PascalCase by framework convention.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["PascalCase", "kebab-case"] }
            }
          }
        }
      }
    }{{ extra_biome_overrides }}
  ]
}
