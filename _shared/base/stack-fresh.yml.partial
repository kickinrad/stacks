# Generated from the {{ stack }} stack; `copier update` replaces this file.
# Weekly: is this project behind the latest template, tools or lockfiles? A red run means "update".
name: stack-fresh
on:
  schedule:
    - cron: "17 13 * * 1"
  workflow_dispatch:
permissions:
  contents: read
jobs:
  fresh:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: jdx/mise-action@fc42bcc7ddbf51124c30f95a877a0c5168a3bfde # v5.2.1
      - run: python3 .agents/stack/check
