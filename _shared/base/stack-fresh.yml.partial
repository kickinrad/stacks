# Generated from the {{ stack }} stack; `copier update` replaces this file.
# Weekly: is this project behind the latest template, tools or lockfiles? A red run means "update".
name: stack-fresh
on:
  schedule:
    - cron: "17 13 * * 1"
  workflow_dispatch:
permissions:
  contents: read
jobs:
  fresh:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: jdx/mise-action@v5
      - run: python3 .agents/stack/check
