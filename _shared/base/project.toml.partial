# Seeded from the {{ stack }} stack; this project contract is the project's to extend.
[project]
name = "{{ project_name }}"

[harnesses]
claude_code = true
codex = true

[git]
profile = "{{ git_profile }}"

[requirements]
shared_instructions = true

[requirements.mise]
tools = [{% for tool in mise_tools %}"{{ tool }}"{% if not loop.last %}, {% endif %}{% endfor %}]
tasks = ["setup", "check", "test"]
{% if package_manager %}
[requirements.package]
manager = "{{ package_manager }}"
{% endif %}
