/**
 * Greets a visitor by name.
 *
 * @param string $name Visitor name.
 * @return string Escaped greeting.
 */
function {{ project_name | replace('-', '_') }}_greeting( string $name ): string {
	return 'Hello, ' . esc_html( $name );
}
